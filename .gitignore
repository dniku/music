# Local reference recordings. Their metadata and checksums are tracked instead.
**/reference/audio/*.mp3
**/reference/audio/*.opus
**/reference/audio/*.webm
**/reference/audio/*.wav

# Superseded source retained locally until it is explicitly removed.
**/sources/full-text.txt

# LilyPond and Nix build outputs.
/build/**
/result
/result-*
*.midi
*.mid
*.pdf
*.ps

# Local development state.
/.direnv/
