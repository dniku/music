if (( $# != 5 )); then
  echo "usage: extract-audio INPUT START DURATION TITLE OUTPUT" >&2
  exit 2
fi

input_path="$1"
start="$2"
duration="$3"
title="$4"
output_path="$5"
temporary_output="$output_path.partial.mp3"

mkdir -p "$(dirname "$output_path")"
rm --force -- "$temporary_output"

ffmpeg \
  -nostdin \
  -hide_banner \
  -loglevel warning \
  -i "$input_path" \
  -ss "$start" \
  -t "$duration" \
  -map 0:a:0 \
  -map_metadata -1 \
  -vn \
  -codec:a libmp3lame \
  -q:a 2 \
  -metadata "title=$title" \
  -y \
  "$temporary_output"

mv -- "$temporary_output" "$output_path"
