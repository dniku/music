*.ly text eol=lf
*.ily text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.nix text eol=lf
*.json text eol=lf
*.tsv text eol=lf
*.yaml text eol=lf
*.dvc text eol=lf

# DVC preserves spaces when folding long commands and paths in generated locks.
dvc.lock whitespace=-trailing-space

*.mp3 binary
*.opus binary
*.webm binary
*.wav binary

# Preserve the user's spacing around chord annotations in source transcripts.
tracks/*/sources/lyrics-with-bar-marks.txt whitespace=-trailing-space
