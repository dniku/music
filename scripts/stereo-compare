if (( $# != 3 )); then
  echo "usage: stereo-compare LEFT_AUDIO RIGHT_AUDIO OUTPUT_MP3" >&2
  exit 2
fi

left_audio="$1"
right_audio="$2"
output_mp3="$3"
temporary_output="$output_mp3.partial.mp3"

mkdir -p "$(dirname "$output_mp3")"
rm --force -- "$temporary_output"

ffmpeg \
  -nostdin \
  -hide_banner \
  -loglevel warning \
  -i "$left_audio" \
  -i "$right_audio" \
  -filter_complex \
    '[0:a]aformat=sample_rates=44100:channel_layouts=mono[left];[1:a]aformat=sample_rates=44100:channel_layouts=mono[right];[left][right]amerge=inputs=2[comparison]' \
  -map '[comparison]' \
  -map_metadata -1 \
  -codec:a libmp3lame \
  -q:a 2 \
  -shortest \
  -y \
  "$temporary_output"

mv -- "$temporary_output" "$output_mp3"
